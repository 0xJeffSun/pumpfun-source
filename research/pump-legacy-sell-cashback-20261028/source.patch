+/// Settles the legacy sell fee and returns the buyback account index and whether
+/// a cashback payment succeeded. Zero fees consume no payment-specific account.
+pub(crate) fn settle_creator_or_cashback<'info>(
+    remaining_accounts: &'info [AccountInfo<'info>],
+    user: &Signer<'info>,
+    system_program: &Program<'info, System>,
+    bonding_curve: &Account<'info, BondingCurve>,
+    creator_vault: &AccountInfo<'info>,
+    amount: u64,
+    mint: &Pubkey,
+    cashback_coin: bool,
+) -> Result<(usize, bool)> {
+    if amount == 0 {
+        return Ok((1, false));
+    }
+    if cashback_coin {
+        pay_cashback(remaining_accounts, user, system_program, bonding_curve, amount, mint)?;
+        Ok((2, true))
+    } else {
+        check_bonding_curve_v2(remaining_accounts, mint)?;
+        crate::legacy_buy::native_payments::ensure_rent_exempt(system_program, user, creator_vault)?;
+        crate::trade::quote_payments::move_native(bonding_curve, creator_vault, amount)?;
+        Ok((1, false))
+    }
+}
