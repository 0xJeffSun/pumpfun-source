+/// Reconstructs the cashback path observed in the original legacy-sell helper.
+/// The caller gates this on a nonzero payment; curve-v2 validation occurs last.
+pub(crate) fn pay_cashback<'info>(
+    remaining_accounts: &'info [AccountInfo<'info>],
+    user: &Signer<'info>,
+    system_program: &Program<'info, System>,
+    bonding_curve: &Account<'info, BondingCurve>,
+    amount: u64,
+    mint: &Pubkey,
+) -> Result<()> {
+    let accumulator = remaining_accounts
+        .first()
+        .ok_or_else(|| error!(PumpError::MissingCashbackAccounts))?;
+    let user_key = user.key();
+    let (expected, bump) = Pubkey::find_program_address(
+        &[b"user_volume_accumulator", user_key.as_ref()],
+        &crate::ID,
+    );
+    require!(
+        accumulator.key() == expected,
+        PumpError::InvalidCashbackAccumulator
+    );
+
+    if accumulator.data_is_empty() {
+        let minimum = Rent::get()?.minimum_balance(137);
+        let bump_seed = [bump];
+        let signer_seeds: &[&[u8]] = &[
+            b"user_volume_accumulator",
+            user_key.as_ref(),
+            &bump_seed,
+        ];
+        let lamports = accumulator.lamports();
+        if lamports < minimum {
+            let shortfall = minimum.saturating_sub(lamports);
+            anchor_lang::system_program::transfer(
+                CpiContext::new(
+                    system_program.to_account_info(),
+                    anchor_lang::system_program::Transfer {
+                        from: user.to_account_info(),
+                        to: accumulator.clone(),
+                    },
+                ),
+                shortfall,
+            )?;
+        }
+        anchor_lang::solana_program::program::invoke_signed(
+            &anchor_lang::solana_program::system_instruction::allocate(
+                accumulator.key,
+                137,
+            ),
+            &[accumulator.clone()],
+            &[signer_seeds],
+        )?;
+        anchor_lang::solana_program::program::invoke_signed(
+            &anchor_lang::solana_program::system_instruction::assign(
+                accumulator.key,
+                &crate::ID,
+            ),
+            &[accumulator.clone()],
+            &[signer_seeds],
+        )?;
+        let mut data = accumulator.try_borrow_mut_data()?;
+        data[..8].copy_from_slice(crate::UserVolumeAccumulator::DISCRIMINATOR);
+        data[8..40].copy_from_slice(user_key.as_ref());
+    } else {
+        require!(
+            accumulator.owner == &crate::ID,
+            PumpError::InvalidCashbackAccumulator
+        );
+        let data = accumulator.try_borrow_data()?;
+        require!(
+            data.len() >= 8 && &data[..8] == crate::UserVolumeAccumulator::DISCRIMINATOR,
+            PumpError::InvalidCashbackAccumulator
+        );
+    }
+
+    crate::trade::quote_payments::transfer_native(bonding_curve, accumulator, amount)?;
+    let mut account = Account::<crate::UserVolumeAccumulator>::try_from(accumulator)?;
+    if account.user == Pubkey::default() {
+        account.user = user_key;
+    }
+    account.cashback_earned = account
+        .cashback_earned
+        .checked_add(amount)
+        .ok_or(error!(PumpError::Overflow))?;
+    account.exit(&crate::ID)?;
+
+    require!(
+        remaining_accounts.len() > 1,
+        PumpError::InvalidBondingCurveV2
+    );
+    let bonding_curve_v2 = &remaining_accounts[1];
+    let (expected, _) = Pubkey::find_program_address(
+        &[b"bonding-curve-v2", mint.as_ref()],
+        &crate::ID,
+    );
+    require!(
+        bonding_curve_v2.key() == expected,
+        PumpError::InvalidBondingCurveV2
+    );
+    Ok(())
+}
