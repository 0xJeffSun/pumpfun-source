+impl trade_types::BondingCurve {
+ #[inline(never)]
+ pub fn buy_quote(&self,amount:u64)->Result<u128>{
+  let numerator=self.virtual_quote_reserves as u128*amount as u128;
+  let denominator=(self.virtual_token_reserves as u128).checked_sub(amount as u128)
+   .ok_or_else(||error!(PumpError::Overflow))?;
+  let quote=numerator.checked_div(denominator as u128)
+   .ok_or_else(||error!(PumpError::DivisionByZero))?;
+  Ok(quote+1)
+ }
