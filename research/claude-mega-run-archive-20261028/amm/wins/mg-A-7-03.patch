+fn read_fee(bytes: &[u8]) -> DecodedTransferFee {
+    DecodedTransferFee {
+        epoch: u64::from_le_bytes(bytes[..8].try_into().unwrap()),
+        maximum_fee: u64::from_le_bytes(bytes[8..16].try_into().unwrap()),
