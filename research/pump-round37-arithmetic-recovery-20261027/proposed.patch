+#[inline(never)]
+pub fn exact_input_tokens(quote:u64,reserve_out:u64,reserve_in:u64)->Result<u64>{
+    let effective=quote.checked_sub(1).ok_or(PumpError::Overflow)?;
+    let amount=crate::constant_product::output(effective as u128,reserve_in as u128,reserve_out as u128)?;
+    u64::try_from(amount).map_err(|_|error!(PumpError::Truncation))
+}
