+pub fn sweep_buyback(ctx:Context<crate::buyback::SweepBuyback>,index:u8)->Result<()>{
+    require_gt!(8u8,index,FeeError::InvalidBuybackIndex);
+    let vault = &mut ctx.accounts.buyback_vault;
+    vault.claim()?;
+    let sol_amount = vault.get_lamports().saturating_sub(Rent::get()?.minimum_balance(vault.to_account_info().data_len()));
+    let token_amount = ctx.accounts.buyback_vault_ata.amount;
+    let index_seed=[index];let bump=[ctx.bumps.buyback_vault];let seeds:&[&[u8]]=&[b"buyback-vault",&index_seed,&bump];
+    anchor_spl::token_interface::transfer_checked(CpiContext::new_with_signer(ctx.accounts.token_program.to_account_info(),anchor_spl::token_interface::TransferChecked{from:ctx.accounts.buyback_vault_ata.to_account_info(),mint:ctx.accounts.mint.to_account_info(),to:ctx.accounts.destination_ata.to_account_info(),authority:vault.to_account_info()},&[seeds]),token_amount,ctx.accounts.mint.decimals)?;
+    vault.sub_lamports(sol_amount)?;
+    ctx.accounts.destination.add_lamports(sol_amount)?;
+    vault.total_claimed=vault.total_claimed.checked_add(sol_amount).ok_or(FeeError::MathOverflow)?;
+    if ctx.accounts.mint.key()==anchor_spl::token::spl_token::native_mint::ID{vault.total_claimed_token1=vault.total_claimed_token1.checked_add(token_amount).ok_or(FeeError::MathOverflow)?;}else{vault.total_claimed_token2=vault.total_claimed_token2.checked_add(token_amount).ok_or(FeeError::MathOverflow)?;}
+    let event=crate::buyback::SweepBuybackEvent{index,sol_amount,token_amount,destination:ctx.accounts.destination.key(),buyback_vault:vault.key(),mint:ctx.accounts.mint.key()};emit!(event);emit_cpi!(event);Ok(())
+}
