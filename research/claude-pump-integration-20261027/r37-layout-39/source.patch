+pub fn estimate_post_complete(creator:&Pubkey,pool_base_before:u64,pool_quote_before:u64,protocol_fee_bps:u64,creator_fee_bps:u64,budget:u64,exact_budget:bool)->Result<Option<PostComplete>>{
