+
+pub fn adjusted_quote(amount: u64, adjustment: i128) -> Result<u128> {
+    (amount as i128).checked_add(adjustment).and_then(|v| u128::try_from(v).ok()).ok_or_else(|| error!(PumpError::Overflow))
+}
