--- ../../base/L32/pump/src/creator/set_creator.rs	1969-12-31 16:00:00
+++ srcB/src/creator/set_creator.rs	2026-10-28 06:16:07
@@ -0,0 +1,90 @@
+use anchor_lang::prelude::*;
+use anchor_spl::metadata::MetadataAccount as CreatorMetadata;
+use anchor_spl::token::Mint;
+
+use crate::trade_types::BondingCurve;
+use crate::{Global, PumpError, SetMetaplexCreatorEvent};
+
+pub const METAPLEX: Pubkey = anchor_lang::solana_program::pubkey!("metaqbxxUerdq28cj1RbAWkYQm3ybzjb6a8bt518x1s");
+
+#[event_cpi]
+#[derive(Accounts)]
+pub struct SetCreator<'info> {
+    pub set_creator_authority: Signer<'info>,
+
+    #[account(
+        seeds = [b"global"],
+        bump,
+        has_one = set_creator_authority @ PumpError::NotAuthorized
+    )]
+    pub global: Account<'info, Global>,
+
+    pub mint: Account<'info, Mint>,
+
+    #[account(
+        seeds = [b"metadata", METAPLEX.as_ref(), mint.key().as_ref()],
+        bump,
+        seeds::program = METAPLEX
+    )]
+    pub metadata: Account<'info, CreatorMetadata>,
+
+    #[account(
+        mut,
+        seeds = [b"bonding-curve", mint.key().as_ref()],
+        bump
+    )]
+    pub bonding_curve: Account<'info, BondingCurve>,
+}
+
+#[event]
+#[derive(Clone)]
+pub struct SetCreatorEvent {
+    pub timestamp: i64,
+    pub mint: Pubkey,
+    pub bonding_curve: Pubkey,
+    pub creator: Pubkey,
+}
+
+pub fn set(mut ctx: Context<SetCreator>, creator: Pubkey) -> Result<()> {
+    let a = &mut ctx.accounts;
+
+    if a.bonding_curve.creator != Pubkey::default() {
+        msg!("Bonding curve has creator already set");
+        return Ok(());
+    }
+
+    let mint = a.mint.key();
+    let bonding_curve = a.bonding_curve.key();
+
+    match &a.metadata.creators {
+        Some(cs) => {
+            // The metaplex creator takes precedence over the requested
+            // creator.
+            let new_owner = cs[0].address;
+            a.bonding_curve.creator = new_owner;
+            let e = SetMetaplexCreatorEvent {
+                timestamp: Clock::get()?.unix_timestamp,
+                mint,
+                bonding_curve,
+                metadata: a.metadata.key(),
+                creator: new_owner,
+            };
+            emit!(e);
+            emit_cpi!(e);
+            return Ok(());
+        }
+        None => {
+            a.bonding_curve.creator = creator;
+            let e = SetCreatorEvent {
+                timestamp: Clock::get()?.unix_timestamp,
+                mint,
+                bonding_curve,
+                creator,
+            };
+            emit!(e);
+            emit_cpi!(e);
+        }
+    }
+
+    Ok(())
+}
