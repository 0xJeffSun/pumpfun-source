+fn add_global_sol_volume(global: &mut GlobalVolumeAccumulator, day: usize, sol_volume: u64) {
+    global.sol_volumes[day] = global.sol_volumes[day]
+        .checked_add(sol_volume)
+        .expect("Overflowing sol volume");
