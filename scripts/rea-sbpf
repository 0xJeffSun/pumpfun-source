#!/usr/bin/env bash
# Use the separately installed, locally adapted REA for captured Solana ELFs.
set -euo pipefail
tool_root="${PUMPFUN_REA_TOOL_ROOT:-$HOME/.local/share/rea-tools}"
node_bin="${PUMPFUN_REA_NODE:-$HOME/.nvm/versions/node/v24.22.1/bin/node}"
rea_root="${PUMPFUN_REA_INSTALL:-$tool_root/rea-agents-6.8.0-sbpf}"
export GHIDRA_INSTALL_DIR="${GHIDRA_INSTALL_DIR:-$tool_root/ghidra_12.1.4_PUBLIC}"
export JAVA_HOME="${JAVA_HOME:-/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home}"
export REA_GHIDRA_LANGUAGE_ID=sBPF:LE:64:v1
if [[ ! -x "$node_bin" || ! -f "$rea_root/scripts/rea.mjs" ]]; then
  echo 'The local REA sBPF installation is missing; see docs/REA.md.' >&2
  exit 1
fi
exec "$node_bin" "$rea_root/scripts/rea.mjs" "$@"
