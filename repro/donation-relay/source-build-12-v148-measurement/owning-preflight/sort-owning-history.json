o}","subscriptions_url":"https://api.github.com/users/RalfJung/subscriptions","organizations_url":"https://api.github.com/users/RalfJung/orgs","repos_url":"https://api.github.com/users/RalfJung/repos","events_url":"https://api.github.com/users/RalfJung/events{/privacy}","received_events_url":"https://api.github.com/users/RalfJung/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"RalfJung","id":330628,"node_id":"MDQ6VXNlcjMzMDYyOA==","avatar_url":"https://avatars.githubusercontent.com/u/330628?v=4","gravatar_id":"","url":"https://api.github.com/users/RalfJung","html_url":"https://github.com/RalfJung","followers_url":"https://api.github.com/users/RalfJung/followers","following_url":"https://api.github.com/users/RalfJung/following{/other_user}","gists_url":"https://api.github.com/users/RalfJung/gists{/gist_id}","starred_url":"https://api.github.com/users/RalfJung/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/RalfJung/subscriptions","organizations_url":"https://api.github.com/users/RalfJung/orgs","repos_url":"https://api.github.com/users/RalfJung/repos","events_url":"https://api.github.com/users/RalfJung/events{/privacy}","received_events_url":"https://api.github.com/users/RalfJung/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"2933f68abefa9e56ac336cb686a435a54e8a1f21","url":"https://api.github.com/repos/anza-xyz/rust/commits/2933f68abefa9e56ac336cb686a435a54e8a1f21","html_url":"https://github.com/anza-xyz/rust/commit/2933f68abefa9e56ac336cb686a435a54e8a1f21"}]},{"sha":"363ae4188316b8b22cf6c1890bc73d84d05f70a4","node_id":"C_kwDOCeQ7u9oAKDM2M2FlNDE4ODMxNmI4YjIyY2Y2YzE4OTBiYzczZDg0ZDA1ZjcwYTQ","commit":{"author":{"name":"bors","email":"bors@rust-lang.org","date":"2024-09-24T18:48:08Z"},"committer":{"name":"bors","email":"bors@rust-lang.org","date":"2024-09-24T18:48:08Z"},"message":"Auto merge of #129587 - Voultapher:opt-for-size-variants-of-sort-impls, r=cuviper\n\nAdd `optimize_for_size` variants for stable and unstable sort as well as select_nth_unstable\n\n- Stable sort uses a simple merge-sort that re-uses the existing - rather gnarly - merge function.\n- Unstable sort jumps directly to the branchless heapsort fallback.\n- select_nth_unstable jumps directly to the median_of_medians fallback, which is augmented with a custom tiny smallsort and partition impl.\n\nSome code is duplicated but de-duplication would bring it's own problems. For example `swap_if_less` is critical for performance, if the sorting networks don't inline it perf drops drastically, however `#[inline(always)]` is also a poor fit, if the provided comparison function is huge, it gives the compiler an out to only instantiate `swap_if_less` once and call it. Another aspect that would suffer when making `swap_if_less` pub, is having to cfg out dozens of functions in in smallsort module.\n\nPart of https://github.com/rust-lang/rust/issues/125612\n\nr​? `@Kobzol`","tree":{"sha":"58b75b9988422548df0f034a2f975f9513ec1ab6","url":"https://api.github.com/repos/anza-xyz/rust/git/trees/58b75b9988422548df0f034a2f975f9513ec1ab6"},"url":"https://api.github.com/repos/anza-xyz/rust/git/commits/363ae4188316b8b22cf6c1890bc73d84d05f70a4","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/anza-xyz/rust/commits/363ae4188316b8b22cf6c1890bc73d84d05f70a4","html_url":"https://github.com/anza-xyz/rust/commit/363ae4188316b8b22cf6c1890bc73d84d05f70a4","comments_url":"https://api.github.com/repos/anza-xyz/rust/commits/363ae4188316b8b22cf6c1890bc73d84d05f70a4/comments","author":{"login":"bors","id":3372342,"node_id":"MDQ6VXNlcjMzNzIzNDI=","avatar_url":"https://avatars.githubusercontent.com/u/3372342?v=4","gravatar_id":"","url":"https://api.github.com/users/bors","html_url":"https://github.com/bors","followers_url":"https://api.github.com/users/bors/followers","f