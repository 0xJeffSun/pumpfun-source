 if wallet&&!wallet_frozen{
  let native=a.quote_mint.key()==anchor_spl::token::spl_token::native_mint::ID;
  // Original ordinary-wallet order: source flags, one ATA prelude, collection/event, AMM.
  let amm_present=!a.coin_creator_vault_ata.data_is_empty();
  let vault_collectible=if native{true}else{
   !a.creator_vault_quote_token_account.data_is_empty()&&!token_frozen(&a.creator_vault_quote_token_account.to_account_info())?
  };
  let amm_collectible=amm_present&&!token_frozen(&a.coin_creator_vault_ata.to_account_info())?;
  if !native||amm_present{
   anchor_spl::associated_token::create_idempotent(CpiContext::new(a.associated_token_program.to_account_info(),anchor_spl::associated_token::Create{payer:a.admin_set_creator_authority.to_account_info(),associated_token:a.current_creator_quote_token_account.to_account_info(),authority:a.current_creator.to_account_info(),mint:a.quote_mint.to_account_info(),system_program:a.system_program.to_account_info(),token_program:a.quote_token_program.to_account_info()}))?;
  }
  if vault_collectible{
   let collected=if native{
    let rent=Rent::get()?;
    let amount=a.creator_vault.lamports().saturating_sub(rent.minimum_balance(0));
    if amount==0{None}else{
     let post_balance=a.current_creator.lamports().saturating_add(amount);
     let required=rent.minimum_balance(a.current_creator.data_len());
     if post_balance<required{None}else{
      anchor_lang::system_program::transfer(CpiContext::new_with_signer(a.system_program.to_account_info(),anchor_lang::system_program::Transfer{from:a.creator_vault.to_account_info(),to:a.current_creator.to_account_info()},&[vaultseeds]),amount)?;
      Some((amount,Pubkey::default()))
     }
    }
   }else{
    let amount=token_raw_amount(&a.creator_vault_quote_token_account.to_account_info())?;
    if amount==0{None}else{
     anchor_spl::token_interface::transfer_checked(CpiContext::new_with_signer(a.quote_token_program.to_account_info(),anchor_spl::token_interface::TransferChecked{from:a.creator_vault_quote_token_account.to_account_info(),mint:a.quote_mint.to_account_info(),to:a.current_creator_quote_token_account.to_account_info(),authority:a.creator_vault.to_account_info()},&[vaultseeds]),amount,a.quote_mint.decimals)?;
     Some((amount,a.quote_mint.key()))
    }
   };
   if let Some((amount,quote_mint))=collected{
    let e=CollectCreatorFeeEvent{timestamp:Clock::get()?.unix_timestamp,creator:old,creator_fee:amount,quote_mint};emit!(e.clone());emit_cpi!(e);
   }
  }
  if amm_collectible{
   let accounts=vec![AccountMeta::new_readonly(a.quote_mint.key(),false),AccountMeta::new_readonly(a.quote_token_program.key(),false),AccountMeta::new_readonly(old,false),AccountMeta::new_readonly(a.coin_creator_vault_authority.key(),false),AccountMeta::new(a.coin_creator_vault_ata.key(),false),AccountMeta::new(a.current_creator_quote_token_account.key(),false),AccountMeta::new_readonly(a.pump_amm_event_authority.key(),false),AccountMeta::new_readonly(AMM,false)];
   invoke_signed(&Instruction{program_id:AMM,accounts,data:vec![160,57,89,42,181,139,43,66]},&[a.quote_mint.to_account_info(),a.quote_token_program.to_account_info(),a.current_creator.to_account_info(),a.coin_creator_vault_authority.to_account_info(),a.coin_creator_vault_ata.to_account_info(),a.current_creator_quote_token_account.to_account_info(),a.pump_amm_event_authority.to_account_info(),a.pump_amm.to_account_info()],&[])?;
  }
 }
