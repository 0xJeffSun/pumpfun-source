+fn collect_wallet_creator_fee<'info>(a:&AdminCto<'info>,vaultseeds:&[&[u8]])->Result<Option<(u64,Pubkey)>>{
+ if a.current_creator.owner==&FEES{return Err(error!(PumpError::UnableToDistributeCreatorVaultMigratedToSharingConfig));}
+ if a.current_creator.executable{msg!("Creator account is executable, so it cannot receive lamports");return Ok(None);}
+ let native=a.quote_mint.key()==anchor_spl::token::spl_token::native_mint::ID;
+   let collected=if native{
+    let rent=Rent::get()?;
+    let amount=a.creator_vault.lamports().saturating_sub(rent.minimum_balance(0));
+    if amount==0{msg!("No creator fee to collect");None}else{
+     let post_balance=a.current_creator.lamports().saturating_add(amount);
+     let required=rent.minimum_balance(a.current_creator.data_len());
+     if post_balance<required{msg!("Creator account does not have enough rent-exemption lamports");None}else{
+      anchor_lang::system_program::transfer(CpiContext::new_with_signer(a.system_program.to_account_info(),anchor_lang::system_program::Transfer{from:a.creator_vault.to_account_info(),to:a.current_creator.to_account_info()},&[vaultseeds]),amount)?;
+      Some((amount,Pubkey::default()))
+     }
+    }
+   }else{
+    let amount=token_raw_amount(&a.creator_vault_quote_token_account.to_account_info())?;
+    if amount==0{msg!("No creator fee to collect");None}else{
+     anchor_spl::token_interface::transfer_checked(CpiContext::new_with_signer(a.quote_token_program.to_account_info(),anchor_spl::token_interface::TransferChecked{from:a.creator_vault_quote_token_account.to_account_info(),mint:a.quote_mint.to_account_info(),to:a.current_creator_quote_token_account.to_account_info(),authority:a.creator_vault.to_account_info()},&[vaultseeds]),amount,a.quote_mint.decimals)?;
+     Some((amount,a.quote_mint.key()))
+    }
+   };
+ Ok(collected)
+}
+
 fn token_frozen(a:&AccountInfo)->Result<bool>{let d=a.try_borrow_data()?;let t=anchor_spl::token_interface::TokenAccount::try_deserialize(&mut &d[..])?;Ok(t.is_frozen())}
 fn token_amount(a:&AccountInfo)->Result<u64>{let d=a.try_borrow_data()?;if d.is_empty(){return Ok(0);}let t=anchor_spl::token_interface::TokenAccount::try_deserialize(&mut &d[..])?;Ok(if t.is_frozen(){0}else{t.amount})}
 fn token_raw_amount(a:&AccountInfo)->Result<u64>{let d=a.try_borrow_data()?;let t=anchor_spl::token_interface::TokenAccount::try_deserialize(&mut &d[..])?;Ok(t.amount)}
