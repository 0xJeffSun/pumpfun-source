name: Metaplex diagnostic coordinate source trial
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  source-build:
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: actions/checkout@v4
        with:
          repository: metaplex-foundation/mpl-token-metadata
          ref: 17e99434af5ead3e989c08f32af33609821d0bc0
          path: work/metaplex-coordinate-source
          persist-credentials: false
      - name: Build inferred source formatting with pinned recipe
        run: >-
          python3 repro/pump/metaplex-diagnostic-coordinate-recovery/build.py
          --dependency token_metadata --metaplex-diagnostic-coordinate-recovery
          --source work/metaplex-coordinate-source
          --output work/metaplex-coordinate-build
      - name: Retain source manifests, build log and complete comparison
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: metaplex-coordinate-build-${{ github.run_id }}
          path: work/metaplex-coordinate-build
          if-no-files-found: error
          retention-days: 30
