{
  "scope": "Synthetic Rust ownership/control-flow microprobes; no target bytes as compiler inputs, no full-program identity inference",
  "profile": {
    "opt_level": "z",
    "overflow_checks": true,
    "lto": true,
    "codegen_units": 1
  },
  "variants": [
    "unified",
    "checked_sub",
    "positive_expression",
    "negative_return",
    "error_first_tail",
    "positive_tail"
  ]
}
