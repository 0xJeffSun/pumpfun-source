+    let dest = remaining_accounts.get(index + 1)
+        .ok_or_else(|| error!(PumpAmmError::BuybackFeeRecipientMissing))?;
+    global_config.validate_buyback_recipient(&owner.key(), &dest.key(), quote_mint, quote_token_program)?;
+    Ok((owner, dest))
