+use crate::*;
+
+#[derive(Default)]
+pub struct AppliedFees {
+    pub lp_fee_bps: u64,
+    pub protocol_fee_bps: u64,
+    pub creator_fee_bps: u64,
+    pub lp_fee: u64,
+    pub protocol_fee: u64,
+    pub creator_fee: u64,
+}
+
+pub fn fee(amount: u64, basis_points: u64) -> Result<u64> {
+    u64::try_from(((amount as u128) * (basis_points as u128) + 9999) / 10000)
+        .map_err(|_| error!(PumpAmmError::Truncation))
+}
+
+fn market_cap(base_mint: &Mint, base_reserve: u64, quote_reserve: u64, mayhem: bool) -> Result<u128> {
+    let supply = if mayhem { 1_000_000_000_000_000 } else { base_mint.supply };
+    (supply as u128)
+        .checked_mul(quote_reserve as u128)
+        .ok_or(PumpAmmError::Overflow)?
+        .checked_div(base_reserve as u128)
+        .ok_or_else(|| error!(PumpAmmError::DivisionByZero))
+}
+
+fn apply(pool: &Pool, amount: u64, lp: u64, protocol: u64, creator: u64) -> Result<AppliedFees> {
+    let lp_fee = fee(amount, lp)?;
+    let protocol_fee = fee(amount, protocol)?;
+    let creator_fee = if pool.coin_creator == Pubkey::default() { 0 } else { fee(amount, creator)? };
+    Ok(AppliedFees { lp_fee_bps: lp, protocol_fee_bps: protocol, creator_fee_bps: creator,
+        lp_fee, protocol_fee, creator_fee })
+}
+
+pub fn select_and_apply<'info>(
+    pool: &Account<'info, Pool>,
+    global_config: &Account<'info, GlobalConfig>,
+    fee_config: &Account<'info, trade::TradeFeeConfig>,
+    fee_program: &AccountInfo<'info>,
+    config_program: &AccountInfo<'info>,
+    base_mint: &InterfaceAccount<'info, Mint>,
+    base_reserve: u64,
+    quote_reserve: u64,
+    quote_amount: u64,
+) -> Result<AppliedFees> {
+    let canonical = pool.creator == Pubkey::find_program_address(
+        &[b"pool-authority", pool.base_mint.as_ref()], &trade::PUMP).0;
+    let cap = market_cap(base_mint, base_reserve, quote_reserve, pool.is_mayhem_mode)?;
+    let mut selected = crate::pump_fees::cpi::get_fees_with_quote_mint(
+        CpiContext::new(fee_program.clone(), crate::pump_fees::cpi::accounts::GetFeesWithQuoteMint {
+            fee_config: fee_config.to_account_info(), config_program_id: config_program.clone(),
+        }), canonical, cap, pool.quote_mint,
+    )?.get();
+    if global_config.creator_fee_configurable && pool.creator_fee_bps != 0 {
+        selected.creator_fee_bps = pool.creator_fee_bps;
+    }
+    apply(pool, quote_amount, selected.lp_fee_bps, selected.protocol_fee_bps, selected.creator_fee_bps)
+}
