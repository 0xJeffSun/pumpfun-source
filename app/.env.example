# All services default to localhost. No production keys are required.
PORT=3001
BACKEND_URL=http://127.0.0.1:3001
# FIXTURES_FILE=/absolute/path/to/sanitized-fixtures.json
# Server-only Solana mainnet RPC. Defaults to the documented public endpoint.
# Use a dedicated HTTPS provider for sustained traffic; never expose its URL in
# NEXT_PUBLIC_* variables. Public mainnet endpoint:
# SOLANA_RPC_URL=https://api.mainnet.solana.com
# Future integrations; leave disabled until implemented and tested.
# DATABASE_URL=
# REDIS_URL=
# PUMP_API_KEY=
