ote token\"},\"sniper\":{\"body\":\"A wallet that bought a coin in the first moments after launch, usually with a bot, to sell into the people who arrive next. A large sniper share means much of the supply can be dumped early.\",\"title\":\"Sniper\"},\"trade\":{\"body\":\"One buy or sell of a coin. Its size is the USD value that moved.\",\"title\":\"Trade\"},\"volume\":{\"body\":\"The total USD value that changed hands in a coin over the last 24 hours. Higher volume usually means more liquidity: easier to get in and out without moving the price.\",\"title\":\"Volume\"},\"wallet\":{\"body\":\"An address on a chain that holds coins and signs its own transactions. You get one per chain, and a person can control any number of them.\",\"title\":\"Wallet\"}},\"find_out_more\":\"Find out more\",\"follower\":\"Follower\",\"follower_one\":\"{{count}} follower\",\"follower_other\":\"{{count}} followers\",\"followers_count\":\"Followers\",\"followers_count_one\":\"{{compact_count}} follower\",\"followers_count_other\":\"{{compact_count}} followers\",\"following\":\"Following\",\"from\":\"From\",\"go\":\"Go\",\"go_back\":\"Go back\",\"hold_to_see_more\":\"Hold to see more\",\"hot\":\"HOT\",\"image_copied_to_clipboard\":\"Image copied to clipboard\",\"info\":\"Info\",\"initializing\":\"Initializing...\",\"kol\":\"KOL\",\"label_create_new_coin\":\"Create new coin\",\"last_used\":\"Last used\",\"learn_more\":\"Learn more\",\"link\":\"Link\",\"link_options_a11y\":\"Link options\",\"loading\":\"Loading...\",\"loading_wallet\":\"Loading wallet...\",\"locked\":\"Locked\",\"logging_in\":\"Logging in...\",\"market_cap\":\"Market Cap\",\"market_cap_short\":\"MC\",\"max\":\"Max\",\"mcap\":\"MCAP\",\"member\":\"Member\",\"member_one\":\"{{count}} member\",\"member_other\":\"{{count}} members\",\"min\":\"Min\",\"mint_address\":\"Mint address\",\"more\":\"More\",\"network_error\":\"Network error\",\"new\":\"New\",\"new_alerts\":\"New alerts\",\"new_callouts\":\"New callouts\",\"new_coins\":\