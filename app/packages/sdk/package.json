{
  "name": "@pump-fun/pump-sdk",
  "version": "4.3.1",
  "description": "Pump Bonding Curve SDK",
  "keywords": [],
  "homepage": "https://github.com/pump-fun/pump-sdk#readme",
  "bugs": {
    "url": "https://github.com/pump-fun/pump-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pump-fun/pump-sdk.git"
  },
  "license": "MIT",
  "author": "pump-fun",
  "packageManager": "pnpm@11.5.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./swap": {
      "types": "./dist/swap/index.d.ts",
      "import": "./dist/swap/index.mjs",
      "require": "./dist/swap/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.mjs",
      "require": "./dist/*/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.2",
    "bn.js": "^5.2.2",
    "undici-types": "^6.20.0",
    "@pump-fun/agent-payments-sdk": "1.0.7"
  },
  "devDependencies": {
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "@types/node": "22.18.6",
    "@types/bn.js": "5.2.0",
    "@types/big.js": "6.2.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm"
    ],
    "branches": [
      {
        "name": "main"
      },
      {
        "name": "devnet",
        "prerelease": true
      }
    ]
  },
  "private": true
}
